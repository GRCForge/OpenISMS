# ── Docker-managed MySQL (default, 3-Container-Setup) ────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=isms
MYSQL_USER=isms_user
MYSQL_PASSWORD=isms_password

# ── External MySQL (Single-Container / externe DB) ───────────────────────────
# DATABASE_URL has priority over the DB_* variables above.
# Example: mysql://isms_user:password@192.168.1.100:3306/isms
# DATABASE_URL=mysql://user:password@host:3306/dbname

# ── Application ──────────────────────────────────────────────────────────────
# REQUIRED — the app refuses to start without these (no insecure fallback since
# v1.8.1). Generate strong random values, e.g.:  openssl rand -hex 32
# JWT_SECRET:     signs login tokens (use >= 32 random chars)
# ENCRYPTION_KEY: encrypts sensitive settings (OIDC client secret) in the DB
# SESSION_SECRET: session cookie secret (used during the OIDC login flow)
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here
SESSION_SECRET=your_session_secret_here

# Public URL of the app — REQUIRED for the OIDC callback to work.
# Doubles as the CORS allow-list: comma-separate several origins if the app is
# reached under more than one name. With NODE_ENV=production (set by the Docker
# image and by install.sh) this list is authoritative — http://localhost:* is
# NOT allowed implicitly there, so add it here if you really need it.
APP_URL=http://localhost:8080

# Set to "true" when running behind an HTTPS reverse proxy.
# SECURE_COOKIES=false

# HSTS (Strict-Transport-Security). Default: 1 year + includeSubDomains, no preload.
# Browsers ignore the header on plain HTTP, so the default is safe for HTTP-only setups.
# HSTS_MAX_AGE=31536000
# HSTS_INCLUDE_SUBDOMAINS=true
# HSTS_PRELOAD=false

# ── Passkeys / WebAuthn ──────────────────────────────────────────────────────
# Defaults work for localhost. In production set these to your domain:
#   WEBAUTHN_RP_ID  = hostname only, no scheme/port (e.g. isms.example.com)
#   WEBAUTHN_ORIGIN = full origin incl. scheme (e.g. https://isms.example.com)
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGIN=

# ── Single Sign-On (OIDC) ────────────────────────────────────────────────────
# Two ways to configure SSO — pick one:
#
#   a) IN THE APP: log in as admin → Administration → Single Sign-On.
#      Nothing to set here. This is the default and needs no restart.
#
#   b) HERE, via the variables below. Use this when the installation is rolled
#      out by configuration management and the login path has to be part of it
#      instead of a manual step after every rebuild.
#
# PRECEDENCE: a field set here WINS. The app then shows it read-only and
# PUT /api/admin/oidc refuses to change it (409) instead of accepting a save
# that would have no effect. A value from here is never written to the
# database — remove the variable and whatever the database held applies again.
#
# Leave a variable out entirely to keep that field editable in the app. An
# empty value counts as "not set", so a stray OIDC_ISSUER= does not wipe the
# configuration.
#
# Works with any OIDC provider (Authentik, Keycloak, Microsoft Entra, Google,
# Zitadel, …). Redirect URI to register at the provider:
#   <APP_URL>/api/auth/oidc/callback
#
# OIDC_ENABLED=true                 # true/1/yes/on — shows the SSO button on the login page
# OIDC_DISPLAY_NAME=Sign in with Authentik
# OIDC_ISSUER=https://auth.example.com/application/o/isms/
# OIDC_CLIENT_ID=openisms
# OIDC_SCOPES=openid profile email
#
# The client secret is used as given and is NOT encrypted into the database —
# it sits in this file in clear, like DB_PASSWORD and ENCRYPTION_KEY itself.
# Whoever can read this file already holds the key that opens the encrypted
# copy, so nothing is lost by that.
# OIDC_CLIENT_SECRET=your_oidc_client_secret_here

# Claim → role mapping, as a JSON array. Set this and it is the ONLY source:
# the table in the app is ignored and shown read-only. Field names are the same
# as the columns in the app.
#
#   role         one of: admin, assessor, dpo, it-staff, owner, viewer,
#                employee, management
#   custom_role  a custom role by NAME (an id from another installation would
#                be worthless here). Use either role or custom_role.
#   priority     higher wins; default 0
#
# If this variable is set but unusable (bad JSON, unknown role, missing field),
# NO mappings apply — not the ones from the database. A typo must not silently
# hand out a different role than intended; the login then falls back to the
# default SSO role. The reason is logged and shown in Administration → SSO.
#
# OIDC_CLAIM_MAPPINGS=[{"claim_path":"groups","claim_value":"isms-admins","role":"admin","priority":100},{"claim_path":"realm_access.roles","claim_value":"isms-audit","custom_role":"Revision","priority":50}]

# ── MCP Server (Model Context Protocol) ─────────────────────────────────────
# Optional static API key for MCP clients (Claude Desktop, Claude Code, etc.)
# If set:  Authorization: Bearer <MCP_SECRET>  grants admin-level MCP access.
# If not set: regular JWT tokens from /api/auth/login are used instead.
# Endpoint: POST/GET/DELETE <APP_URL>/mcp
# Generate: openssl rand -hex 32
# MCP_SECRET=your_mcp_secret_here

# ── GHCR image version (only for docker-compose.ghcr*.yml) ───────────────────
# ISMS_VERSION=latest
